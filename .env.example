# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored and must stay that way -- it is the only file in the repo
# that holds secrets. Google OAuth additionally needs credentials.json in the
# project root (downloaded from the Google Cloud Console); that JSON format is
# required by the Desktop OAuth flow and cannot live in this file. It is
# gitignored too, as is the token.json the first sign-in writes.
#
# See SETUP.md for what to do after filling this in.

# ---- Required: the two AI APIs ----

# The agents (research + Drive librarian). https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Embeddings, for both ingestion and search. https://voyageai.com/
# voyage-4-lite is on a free token tier -- see config.EMBED_MODEL.
VOYAGE_API_KEY=pa-...

# Optional. Only for scanned/image-only PDFs. Without it a scanned book is
# marked needs_ocr and skipped -- the run does NOT fail. https://mistral.ai/
MISTRAL_API_KEY=

# ---- Required: the database ----

# Postgres with the pgvector extension. Two ways to get one:
#
#   Local Docker (what `make db-up` starts, and the simplest place to begin):
DATABASE_URL=postgresql://app:app@localhost:5434/library
#
#   Or Supabase, if you want a hosted database. Use the SESSION pooler URI --
#   transaction mode breaks psycopg's prepared statements:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The test suite CREATEs and DROPs databases, so it refuses any non-local host
# outright. Leave this pointing at local Docker even when DATABASE_URL is not.
TEST_DATABASE_URL=postgresql://app:app@localhost:5434/library

# ---- Optional: Supabase Storage ----
# When both are set, every ingested PDF is mirrored to the bucket and citations
# serve signed URLs so "open at p.54" opens the real PDF. When either is blank,
# the app keeps working and serves PDFs from local disk instead.
# SUPABASE_URL is the project URL; the key is Project Settings -> API Keys ->
# service_role (the secret one, NOT anon). Treat it like a password.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=library-bucket

# ---- Optional: Google Drive scoping ----
# The top folder of the shared drive to mirror and browse. Defaults to the
# folder this project was built against, which you almost certainly cannot see
# -- set your own, or leave it unset to mirror everything the signed-in account
# can reach (which on a personal account includes your own documents).
# DRIVE_ROOT_FOLDER_ID=
# PILOT_FOLDER_ID=

# ---- Optional: limits (defaults in config.py) ----
# MAX_UPLOAD_MB=64          # per-file cap on the PDF upload endpoint
# FOLDER_INDEX_LIMIT_MB=500 # ceiling for "index this whole folder" in one click
# LIBRARY_RAG_DATA_DIR=     # where markdown/uploads/pdfs live; defaults to ./data
