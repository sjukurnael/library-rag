# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Google OAuth still uses credentials.json in the project root
# (downloaded from Google Cloud Console) -- that JSON format is
# required by the Desktop OAuth flow and can't live in this file.

ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Phase 1: ingestion pipeline ---

# Required for ingest.py and search.py -- both embed with voyage-3.
VOYAGE_API_KEY=pa-...

# Optional. Only needed for scanned/image-only PDFs. If unset, scanned
# books are marked needs_ocr and skipped (the run does NOT fail).
MISTRAL_API_KEY=

# Optional overrides -- defaults live in config.py.
# DATABASE_URL=postgresql://app:app@localhost:5434/library
# PILOT_FOLDER_ID=1ZkjfpG7KPve2grlQhJ7ZHXLhuyC9b5tL
